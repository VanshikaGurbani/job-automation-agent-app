# Copy this file to .env and configure your settings

# ============================================================================
# LLM Configuration - AI Models
# ============================================================================

# Primary LLM Provider (gemini recommended for best results)
LLM_PROVIDER=gemini

# Google Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Gemini Model Options:
# gemini-1.5-pro      - Most capable, best for complex tasks
# gemini-1.5-flash    - Faster, good balance (recommended)
# gemini-pro          - Original model

# Get your API key from: https://makersuite.google.com/app/apikey

# ============================================================================
# Alternative: Ollama (Local, Free)
# ============================================================================
# LLM_PROVIDER=ollama
# OLLAMA_MODEL=llama2
# OLLAMA_BASE_URL=http://localhost:11434

# Alternative models you can use (after pulling with 'ollama pull <model>'):
# OLLAMA_MODEL=mistral       # Faster, good quality
# OLLAMA_MODEL=llama2:13b    # More powerful, slower
# OLLAMA_MODEL=codellama     # Best for tech/engineering resumes

# ============================================================================
# Google Drive Integration (Optional)
# ============================================================================
# If you want to auto-upload documents to Google Drive:
GOOGLE_DRIVE_CREDENTIALS_FILE=credentials.json

# ============================================================================
# Notes:
# ============================================================================
# 1. Ollama is 100% FREE and runs locally on your machine
# 2. No API costs, no rate limits, complete privacy
# 3. Google Drive integration is optional - files save locally by default
# 4. To get started:
#    - Install Ollama: https://ollama.ai/
#    - Run: ollama serve
#    - Pull a model: ollama pull llama2
# 5. For help, see SETUP_GUIDE.md

